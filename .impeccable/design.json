  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "description": "Navy main action with white text, navy hover, and visible teal keyboard focus.",
      "html": "<button class=\"ds-primary\">Zaloguj się</button>",
      "css": ".ds-primary{font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:16px;line-height:1.4;min-height:52px;padding:14px 24px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;gap:12px;cursor:pointer;transition:background .18s,color .18s,border-color .18s;background:var(--navy,#152b4b);color:var(--surface,#fff);border:1px solid var(--navy,#152b4b);font-weight:600;}.ds-primary:hover{background:var(--navy-hover,#234168);border-color:var(--navy-hover,#234168)}.ds-primary:focus-visible{outline:3px solid var(--accent,#08786a);outline-offset:4px;}.ds-primary:disabled{cursor:wait;opacity:.6}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}",
      "refersTo": "button-primary"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "description": "Outlined alternative with a quiet hover surface and teal keyboard focus.",
      "html": "<button class=\"ds-secondary\">Włącz kamerę</button>",
      "css": ".ds-secondary{font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:16px;line-height:1.4;min-height:52px;padding:14px 24px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;gap:12px;cursor:pointer;transition:background .18s,color .18s,border-color .18s;background:#fff;color:var(--navy,#152b4b);border:1px solid #b8c6d7;font-weight:500;}.ds-secondary:hover{background:#f3f7fc;border-color:#8297ae}.ds-secondary:focus-visible{outline:3px solid var(--accent,#08786a);outline-offset:4px;}.ds-secondary:disabled{cursor:wait;opacity:.6}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}",
      "refersTo": "button-secondary"
    },
    {
      "name": "Text Action",
      "kind": "button",
      "description": "Lower-priority teal action with underlined hover and a 44px minimum hit area.",
      "html": "<button class=\"ds-text\">Potrzebuję pomocy</button>",
      "css": ".ds-text{font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:16px;line-height:1.6;font-weight:500;min-height:44px;padding:8px 0;color:var(--accent,#08786a);background:none;border:0;text-align:left;cursor:pointer;transition:background .18s,color .18s,border-color .18s;}.ds-text:hover{text-decoration:underline;text-underline-offset:4px}.ds-text:focus-visible{outline:3px solid var(--accent,#08786a);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-text{transition:none}}"
    },
    {
      "name": "History Search Field",
      "kind": "input",
      "description": "Canonical labeled field with a muted inline search icon, 48px left inset, and hover/focus/invalid states; application filtering lives in app.js.",
      "html": "<label class=\"ds-field ds-history-search\"><span>Szukaj w historii</span><div class=\"ds-search-control\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"6\"/><path d=\"m15 15 6 6\"/></svg><input class=\"ds-input\" type=\"search\" placeholder=\"Odbiorca, tytuł lub data\" autocomplete=\"off\"></div></label>",
      "css": ".ds-field{display:block;font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;line-height:1.6;color:var(--ink,#172d4d);margin-bottom:24px}.ds-field>span{display:block;font-size:16px;font-weight:500;margin-bottom:10px}.ds-input{font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:16px;line-height:1.6;width:100%;min-width:0;height:56px;background:#fff;border:1px solid #b8c6d7;border-radius:8px;padding:14px 16px;color:var(--navy,#152b4b);caret-color:var(--accent,#08786a);transition:border-color .18s}.ds-input::placeholder{color:#647285;opacity:1}.ds-input:hover{border-color:#8297ae}.ds-input:focus,.ds-input:focus-visible{outline:3px solid var(--accent,#08786a);outline-offset:3px;border-color:var(--accent,#08786a)}.ds-input[aria-invalid=true]{border-color:var(--error,#a22f36)}@media(prefers-reduced-motion:reduce){.ds-input{transition:none}} .ds-history-search{width:100%;max-width:420px;margin:0}.ds-search-control{position:relative}.ds-search-control svg{position:absolute;top:18px;left:16px;color:var(--muted,#5b6b7d);pointer-events:none}.ds-search-control input{padding-left:48px}",
      "refersTo": "history-search"
    },
    {
      "name": "Bank Navigation",
      "kind": "nav",
      "description": "Muted labels with a teal underline and text on the current banking section.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Nawigacja konta\"><button class=\"ds-nav-active\" aria-current=\"page\">Moje konto</button><button>Przelewy</button><button>Historia</button></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:32px;margin-bottom:28px;border-bottom:1px solid var(--line,#dae2eb);font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;line-height:1.6}.ds-nav button{font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;line-height:1.6;min-height:56px;font-size:15px;font-weight:500;color:var(--muted,#5b6b7d);border:0;border-bottom:2px solid transparent;background:none;padding:0 0 12px;cursor:pointer;transition:background .18s,color .18s,border-color .18s;}.ds-nav .ds-nav-active{color:var(--accent,#08786a);border-color:var(--accent,#08786a)}.ds-nav button:hover{color:var(--navy,#152b4b)}.ds-nav button:focus-visible{outline:3px solid var(--accent,#08786a);outline-offset:4px;}@media(max-width:1023px){.ds-nav{margin-bottom:28px}}@media(max-width:699px){.ds-nav{gap:28px}}@media(prefers-reduced-motion:reduce){.ds-nav button{transition:none}}",
      "refersTo": "navigation-active"
    },
    {
      "name": "Example Chip",
      "kind": "chip",
      "description": "Informational example-data label with 12px regular type.",
      "html": "<span class=\"ds-chip\">Przykładowe</span>",
      "css": ".ds-chip{font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#dfe8f2;color:#445d77;font-size:12px;font-weight:400;line-height:1.6;border-radius:4px;padding:2px 6px}",
      "refersTo": "chip"
    },
    {
      "name": "Account Card",
      "kind": "card",
      "description": "Navy balance surface with tabular figures, light account metadata, and a borderless mint action; example values.",
      "html": "<section class=\"ds-account\" aria-label=\"Przykładowe konto\"><div class=\"ds-account-name\">Konto osobiste</div><div class=\"ds-account-number\">28 0000 0000 0000 0000 0000 0482</div><div class=\"ds-balance-label\">Dostępne środki</div><div class=\"ds-balance\">18 420,50 <span>PLN</span></div><div class=\"ds-account-actions\"><button class=\"ds-account-button\">Nowy przelew</button></div></section>",
      "css": ".ds-account{font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;line-height:1.6;background:var(--navy,#152b4b);color:#fff;padding:32px;border-radius:var(--radius,14px);display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px 24px}.ds-account-name{font-size:17px;font-weight:500}.ds-account-number{font-size:14px;color:#b6c7dd;margin-top:4px;overflow-wrap:anywhere}.ds-balance-label{font-size:14px;color:#b6c7dd;margin-top:24px}.ds-balance{font-size:40px;line-height:1.3;font-weight:500;letter-spacing:-.6px;font-variant-numeric:tabular-nums}.ds-balance span{font-size:20px;font-weight:400;margin-left:8px}.ds-account-actions{grid-column:2;grid-row:1/5;align-self:center}.ds-account-button{font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:16px;line-height:1.4;min-height:52px;padding:14px 24px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;gap:12px;cursor:pointer;transition:background .18s,color .18s,border-color .18s;background:var(--mint,#67e8c5);color:var(--navy,#152b4b);border:0;font-weight:600}.ds-account-button:hover{background:var(--mint-hover,#4bdbb2)}.ds-account-button:focus-visible{outline:3px solid var(--accent,#08786a);outline-offset:4px;}@media(max-width:1279px){.ds-account-actions{grid-column:1;grid-row:auto;margin-top:16px}}@media(max-width:1023px){.ds-account-actions{grid-column:2;grid-row:1/5;margin:0}}@media(max-width:699px){.ds-account{grid-template-columns:1fr;padding:24px}.ds-account-actions{grid-row:auto;grid-column:1;margin-top:16px}.ds-balance{font-size:36px}.ds-account-number{font-size:13px}}@media(prefers-reduced-motion:reduce){.ds-account-button{transition:none}}",
      "refersTo": "account-card"
    },
    {
      "name": "Measurement Disclosure",
      "kind": "custom",
      "description": "Native disclosure for live experimental camera estimates; it remains optional and explains current, stale, and unavailable results.",
      "html": "<details class=\"ds-parameters\"><summary><span class=\"ds-parameter-title\">Parametry sesji</span><svg class=\"ds-chevron\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></summary><div class=\"ds-parameter-content\"><p>Wyniki analizy są eksperymentalne i mogą być niedostępne.</p><dl><div><dt>Estymowany puls</dt><dd>72 <span>BPM</span></dd></div><div><dt>Stan analizy</dt><dd>Analiza obrazu</dd></div></dl></div></details>",
      "css": ".ds-parameters{font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;line-height:1.6;background:var(--camera,#fff);color:var(--ink,#172d4d);border-top:1px solid #ccd7e4;border-bottom:1px solid #ccd7e4;padding-block:4px}.ds-parameters>summary{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:64px;font-size:15px;list-style:none;cursor:pointer}.ds-parameter-title{display:flex;align-items:center;flex-wrap:wrap;gap:8px;font-weight:500}.ds-parameters>summary::-webkit-details-marker{display:none}.ds-parameters>summary:focus-visible{outline:3px solid var(--accent,#08786a);outline-offset:4px;}.ds-parameter-chip{background:#dfe8f2;color:#445d77;font-size:12px;font-weight:400;border-radius:4px;padding:2px 6px}.ds-chevron{color:var(--muted,#5b6b7d);transition:transform .2s}.ds-parameters[open] .ds-chevron{transform:rotate(180deg)}.ds-parameter-content{padding-bottom:20px;animation:ds-reveal .22s var(--ease,cubic-bezier(.22,1,.36,1))}.ds-parameter-content p{font-size:13px;color:var(--muted,#5b6b7d);margin:0 0 16px}.ds-parameter-content dl{margin:0}.ds-parameter-content dl>div{display:flex;justify-content:space-between;gap:16px;padding:8px 0;font-size:14px}.ds-parameter-content dt{color:var(--muted,#5b6b7d)}.ds-parameter-content dd{margin:0;font-weight:500;font-variant-numeric:tabular-nums;text-align:right}.ds-parameter-content dd span{font-size:12px;font-weight:400;color:var(--muted,#5b6b7d)}@keyframes ds-reveal{from{opacity:.65;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}@media(prefers-reduced-motion:reduce){.ds-parameter-content{animation:none}.ds-chevron{transition:none}}"
    },
    {
      "name": "Camera Panel",
      "kind": "card",
      "description": "Bordered white optional camera panel with a consented video-only WebRTC transmission to a local analysis server, active/off/error captions, and no audio or recordings.",
      "html": "<aside class=\"ds-camera\" aria-label=\"Kamera\"><div class=\"ds-camera-heading\"><h2>Kamera</h2><span class=\"ds-camera-label\">Opcjonalna</span></div><p class=\"ds-camera-description\">Obraz pomaga zbierać dane do badania. Kamera nie potwierdza Twojej tożsamości.</p><div class=\"ds-preview\"><div class=\"ds-placeholder\"><strong>Podgląd wyłączony</strong><span>Uruchom, gdy będziesz gotowy</span></div><div class=\"ds-caption\"><span>Kamera wyłączona</span><span>Bez dźwięku</span></div></div></aside>",
      "css": ".ds-camera{font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;line-height:1.6;background:var(--camera,#fff);border:1px solid var(--line,#dae2eb);color:var(--ink,#172d4d);border-radius:16px;padding:32px;min-width:0}.ds-camera-heading{display:flex;align-items:center;gap:10px;margin-bottom:16px}.ds-camera h2{font-size:24px;line-height:1.3;letter-spacing:-.4px;margin:0;font-weight:500}.ds-camera-label{margin-left:auto;font-weight:400;color:var(--muted,#5b6b7d);font-size:12px;padding:4px 8px;background:var(--canvas,#f7f9fc);border-radius:4px}.ds-camera-description{color:var(--muted,#5b6b7d);font-size:15px;margin:0 0 24px;line-height:1.6;max-width:42ch}.ds-preview{position:relative;display:grid;grid-template-rows:minmax(0,1fr) auto;aspect-ratio:1.55;background:#eef3f5;border-radius:var(--radius,14px);overflow:hidden;isolation:isolate}.ds-placeholder{position:relative;grid-area:1/1;min-height:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:8px;color:#516274;font-size:14px;padding:16px;text-align:center}.ds-placeholder strong{font-weight:500;color:var(--navy,#152b4b);font-size:16px}.ds-caption{position:relative;grid-area:2/1;z-index:1;padding:12px 16px;font-size:12px;display:flex;justify-content:space-between;gap:8px;color:var(--muted,#5b6b7d);background:#e8eef1}@media(max-width:1279px){.ds-camera{padding:28px}}@media(max-width:1023px){.ds-camera{padding:24px}.ds-camera h2{font-size:22px}.ds-camera-description{margin-top:16px}.ds-preview{aspect-ratio:1.8}}@media(max-width:699px){.ds-camera h2{font-size:21px}.ds-camera-heading{margin-bottom:0}.ds-camera-label{display:none}.ds-preview{aspect-ratio:1.5}}",
      "refersTo": "camera-panel"
    },
    {
      "name": "Bank24 SVG Logo",
      "kind": "custom",
      "description": "Authored B mark with open loops and an outlined IBM Plex Sans Bank24 wordmark; widths are 190px, 148px and 126px with automatic height.",
